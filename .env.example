FLASK_ENV=development
SECRET_KEY=cambia-esta-clave-por-una-generada-con-secrets-token-hex

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=egresados
MYSQL_POOL_SIZE=10

RATELIMIT_STORAGE_URI=memory://

CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=60

MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-responder@liceotame.edu.co

MAX_CONTENT_LENGTH_MB=3

# Orígenes externos que pueden consumir /api/v1 (separados por coma).
# Vacío = solo el mismo sitio. Nunca usar "*".
CORS_ORIGINS=

# Copia este archivo a ".env" (ya está en .gitignore) y llena los valores reales.
# Nada de esto tiene credenciales verdaderas: son placeholders.

# ---- Flask ----
FLASK_ENV=development
SECRET_KEY=cambia-esta-clave-por-una-generada-con-secrets-token-hex

# ---- MySQL ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=via_app
MYSQL_PASSWORD=
MYSQL_DB=via_db
MYSQL_POOL_SIZE=10

# ---- Rate limiting (Flask-Limiter) ----
# En memoria por defecto (alcanza para ~5000 usuarios en una sola instancia).
# Para varias instancias detrás de un balanceador, usa Redis:
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# ---- Caché (Flask-Caching) ----
# "SimpleCache" vive en el proceso Python. Si despliegas con más de un
# worker/proceso, cambia a Redis para que todos vean la misma caché:
# CACHE_TYPE=RedisCache
# CACHE_REDIS_URL=redis://localhost:6379/1
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=60

# ---- Correo (recuperación de contraseña, notificaciones) ----
# Si se dejan vacíos, el correo no se envía de verdad: queda solo
# registrado en consola (modo desarrollo). Ver backend/utils.py.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-responder@liceotame.edu.co

# ---- Subida de fotos de perfil ----
MAX_CONTENT_LENGTH_MB=3
